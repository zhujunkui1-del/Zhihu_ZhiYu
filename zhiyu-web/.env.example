# ===== 知遇 ZhiYu 环境变量模板 =====
#
# 用法：复制为 .env 后填写。.env 永不提交（已在 .gitignore 中）。
#
# 部署到 Vercel 时，把这些变量填进 Project → Settings → Environment Variables。
# 标记说明：
#   【必需】不填跑不起来
#   【生产必需】开发环境会自动回落，但生产必须配
#   【可选】不填则该功能自动回退（例如知乎 OAuth 未配时回退演示登录）

# ─────────────────────────────────────────────────────────────────────────────
# 数据库
# ─────────────────────────────────────────────────────────────────────────────

# 【必需】运行时连接（Neon 池化连接，host 带 -pooler）
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# 【必需】Prisma 迁移/CLI 用的直连地址（Neon unpooled，host 不带 -pooler）
# 由 prisma.config.ts 读取，`prisma migrate` 与 `prisma db` 命令依赖它
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# 加密密钥
# ─────────────────────────────────────────────────────────────────────────────

# 【生产必需】会话与 OAuth Token 的加密主密钥，32 字节 base64
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 生产环境不配会在保存密钥时报错（这是有意为之）；开发环境自动回落
AUTH_ENC_KEY=""

# 【可选】BYOK 的 API Key 加密密钥；未配置时用 AUTH_ENC_KEY 派生
USER_LLM_KEY_ENC=""

# ─────────────────────────────────────────────────────────────────────────────
# 知乎 OAuth（不配也能用：登录页会自动回退到「演示登录」）
# ─────────────────────────────────────────────────────────────────────────────

# App ID 不是 Secret，可以提交；App Key 是 Secret
ZHIHU_APP_ID=""
ZHIHU_OAUTH_APP_KEY=""

# 【可选】读用户创作 / 关注 / 收藏（developer.zhihu.com 的用户数据 API）
ZHIHU_ACCESS_SECRET=""

# 【可选】OAuth 回调地址。
# 必须与知乎开放平台登记值**逐字一致**，且为公网 HTTPS。
# 本地 127.0.0.1 / localhost 只能预览页面，无法完成真实登录。
# 部署到 Vercel 并绑定自有域名后填：
#   https://zhiyuapp.site/api/auth/zhihu/callback
ZHIHU_OAUTH_REDIRECT_URI=""

# ─────────────────────────────────────────────────────────────────────────────
# 知乎社区 API（另一套鉴权：HMAC-SHA256 签名，与 OAuth 无关）
# 说明与实测记录见 lib/zhihu/community-api.ts
# ─────────────────────────────────────────────────────────────────────────────

# app_secret 申请：https://www.zhihu.com/ring/moltbook
ZHIHU_COMMUNITY_APP_SECRET=""
# user_token：个人主页链接 people/ 后面那串
ZHIHU_COMMUNITY_USER_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# 以下是**预留**变量，当前代码未使用（填了也不会生效，留作后续接入）
# ─────────────────────────────────────────────────────────────────────────────

# 平台级 AI Key（规划中：平台自带 AI Persona / 离线种子；真人会话走用户 BYOK）
AI_API_KEY=""

# 飞书开放平台（规划中：飞书数据源接入）
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
