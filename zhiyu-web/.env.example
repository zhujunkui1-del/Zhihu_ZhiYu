# ===== 知遇 ZhiYu 环境变量示例（复制为 .env 后填写，.env 永不提交）=====

# 运行时数据库连接（Neon / Vercel Postgres；推荐使用池化连接）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Prisma 迁移/直连用（Neon 的非池化直连，通常带 -pooler 之外的 host）
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# 平台级 AI Key（可选）：仅用于平台自带 AI Persona / 离线种子；真人会话走用户 BYOK
AI_API_KEY=""

# 知乎开放平台（App ID 非 Secret；两个 Secret 变量名与官方 skill 一致）
ZHIHU_APP_ID=""
ZHIHU_OAUTH_APP_KEY=""
ZHIHU_ACCESS_SECRET=""

# 知乎 OAuth 回调地址。
# 必须与知乎开放平台登记值**逐字一致**，且为公网 HTTPS
# （本地 127.0.0.1 / localhost 只能预览页面，无法完成真实登录）。
# 部署到 Vercel 并绑定自有域名后填入，例如：
#   https://<你的域名>/api/auth/zhihu/callback
ZHIHU_OAUTH_REDIRECT_URI=""

# 用户 BYOK 密钥加密（AES-GCM 用，32 字节 base64；示例仅占位）
# 生产环境**必须**配置，否则保存 API Key 会直接报错（开发环境自动回落）
USER_LLM_KEY_ENC=""
# 会话与 OAuth Token 的加密主密钥（32 字节 base64）；未配 USER_LLM_KEY_ENC 时也用它派生
AUTH_ENC_KEY=""

# 飞书开放平台（启用飞书接入时填写）
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
