# ===== 知遇 ZhiYu 环境变量示例（复制为 .env 后填写，.env 永不提交）=====

# 运行时数据库连接（Neon / Vercel Postgres；推荐使用池化连接）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Prisma 迁移/直连用（Neon 的非池化直连，通常带 -pooler 之外的 host）
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# 平台级 AI Key（可选）：仅用于平台自带 AI Persona / 离线种子；真人会话走用户 BYOK
AI_API_KEY=""

# 知乎开放平台（App ID 非 Secret；两个 Secret 变量名与官方 skill 一致）
ZHIHU_APP_ID=""
ZHIHU_OAUTH_APP_KEY=""
ZHIHU_ACCESS_SECRET=""

# 用户 BYOK 密钥加密（AES-GCM 用，32 字节 base64；示例仅占位）
USER_LLM_KEY_ENC=""

# 飞书开放平台（启用飞书接入时填写）
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
