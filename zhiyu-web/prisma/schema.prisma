// 知遇 ZhiYu — 数据模型（以《产品方案/多平台数据接入方案.md》《AI模型接入设置方案.md》为准）
// 注意：embedding 使用 pgvector 扩展（extension 需在数据库中启用，迁移时处理）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PersonaKind {
  human // 真人（注册授权用户）
  public_creator // 知乎公开创作者（大V，非本人入驻）
  synthetic // AI 演示人格（虚构）
}

enum PersonaSourceType {
  wechat
  qq
  feishu
  dingtalk
  zhihu
  sbti
}

enum AgentSessionStatus {
  pending
  running
  analyzing
  completed
  failed
}

model User {
  id              String   @id @default(cuid())
  username        String?  @unique
  displayName     String?
  avatarUrl       String?
  // 知乎数字 uid。刻意用 String：
  // uid 是 18~19 位十进制数，超过 JS 安全整数范围（9007199254740991），
  // 经 JSON.parse 会**静默舍入**（实测 904491330657081871 → 904491330657081900）。
  zhihuOpenId     String?  @unique
  // 知乎 hash_id：字符串标识，与 uid 一起用于展示与去重
  zhihuHashId     String?
  zhihuAuthorized Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  persona            Persona?
  communicationPrefs CommunicationPrefs?
  llmConfigs         LlmProviderConfig[]
  notifications      Notification[]
  sessions           AuthSession[]
  linkedAccounts     LinkedAccount[]
}

/// 应用自己的登录会话。
///
/// 为什么落库而不是进程内 Map：本项目部署在 Vercel（Serverless、多实例），
/// 进程内存储无法跨实例共享，会在请求落到另一个实例时"登录态消失"。
/// 浏览器只持有不可猜的 `token`（放在 HttpOnly Cookie），
/// 知乎的 access_token 加密后留在服务端。
model AuthSession {
  id        String   @id @default(cuid())
  /// 随机会话标识（放在 HttpOnly Cookie 里的那个值），全局唯一
  token     String   @unique
  userId    String
  /// 知乎 OAuth access_token 的密文（AES-256-GCM，见 lib/crypto.ts）
  zhihuTokenEnc String?
  /// access_token 过期时间；到点后停止读取，不静默改用 Access Secret
  tokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// OAuth 授权请求的 state（CSRF 防重放）。
///
/// 规格要求：服务端生成不可预测的随机值 → 绑定当前浏览器会话 → 短时有效 →
/// 回调时校验 → **原子消费**（消费掉就不能再用，防重复回调复用）。
model OAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  /// 发起授权时浏览器已有的会话 token（用于把 state 绑定到该浏览器）
  sessionToken String?
  /// 发起时所在的路径，回调后跳回
  returnTo  String?
  consumedAt DateTime?
  /// 此次授权**成功**后发出的会话 token。
  ///
  /// 为什么要存：回调是 GET，手机端极易被请求第二次 —— 用户下拉刷新、
  /// Safari/微信内置浏览器的预取或预渲染、前进/后退、扫码后重复打开。
  /// 第一次已经把 state 消费掉、把一次性 code 换成 token 了，
  /// 第二次再走一遍必然失败，用户看到的就是「授权状态校验失败」。
  /// 存下结果后第二次可**幂等重放**：把同一张会话 Cookie 再种一遍直接进站。
  resultSessionToken String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// 沟通偏好（设置页 02，三个开关默认全开）
model CommunicationPrefs {
  id                  String  @id @default(cuid())
  userId              String  @unique
  allowAgentInvite    Boolean @default(true)
  showSimilarity      Boolean @default(true)
  allowReportDelivery Boolean @default(true)
  /// 是否使用「知遇提供的大模型」驱动 Agent 对话与人格蒸馏（#7）。
  /// 默认开启 —— 首次进来的用户不需要自带 Key 就能跑通整条链路。
  /// 2026-09-23 前免费，之后由服务端按日期自动收紧（见 lib/llm/platform.ts）。
  usePlatformLlm      Boolean @default(true)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Persona {
  id           String      @id @default(cuid())
  userId       String?     @unique
  kind         PersonaKind @default(human)
  displayName  String
  bio          String?
  // 公开创作者：知乎主页/内容标识，便于展示原文来源
  publicRef    String?
  completeness Float       @default(0)

  // 地域：发现页的「地区」筛选依据。
  // 真实用户的省份/城市可从知乎资料带入；演示人格为虚构值。
  province String?
  city     String?

  // 是否接受他人派 Agent 与我对话。
  // 发现页据此决定是否显示「让 Agent 先聊聊」按钮。
  // 注意与 CommunicationPrefs.allowAgentInvite 的分工：
  //   · allowAgentInvite 是**用户级**开关（设置页 02），约束"别人能不能对我发起"
  //   · 这里是**人设级**的展示属性，用于列表快速过滤；真正拦截仍以用户级开关为准
  agentOpen Boolean @default(true)

  identity           Json?
  interests          Json?
  topics             Json?
  thinkingStyle      Json?
  communicationStyle Json?
  values             Json?
  socialStyle        Json?
  personality        Json?
  confidence         Json?
  // TODO(P1): 启用 pgvector（CREATE EXTENSION vector）后恢复 embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources  PersonaSource[]
  evidence PersonaEvidence[]
  features PersonaFeature[]
  matchAsA Match[]           @relation("PersonaAsA")
  matchAsB Match[]           @relation("PersonaAsB")

  @@index([province])
  @@index([city])
}

/// 站点级的第三方平台应用凭证（飞书 / 钉钉）。
///
/// 为什么不只用环境变量：环境变量要用户去 Vercel 后台加，多一步、易错。
/// 这里让**运营者在本站设置页填一次**，服务端加密存库 ——
/// 之后所有访客点「同步数据」都能直接走授权，不用再碰任何配置文件。
/// app_secret 加密落库（lib/crypto.ts），**永不回传前端**。
model PlatformApp {
  id             String   @id @default(cuid())
  /// provider：feishu | dingtalk
  provider       String   @unique
  appId          String
  appSecretEnc   String
  /// 回调地址（用户填到平台后台的那个），存下来便于一键复制与自检
  redirectUri    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

/// 已授权的第三方账号（飞书 / 钉钉）。
///
/// 为什么要单独一张表而不是复用 AuthSession.zhihuTokenEnc：
///   · 知乎的 token 与**登录**绑定（登录态即授权态），换个浏览器就要重登；
///     而飞书/钉钉是"往已登录账号上挂一个数据源"，不该影响登录态。
///   · 同一用户可能同时授权多个平台，且各自的 refresh_token / 过期时间不同。
/// token 一律 AES-256-GCM 加密后落库（见 lib/crypto.ts），**绝不进 Cookie 或日志**。
model LinkedAccount {
  id             String   @id @default(cuid())
  userId         String
  /// provider：feishu | dingtalk
  provider       String
  /// 平台侧的用户标识（open_id / unionId 等），仅用于展示与排查
  externalId     String?
  displayName    String?
  accessTokenEnc String
  refreshTokenEnc String?
  /// access_token 失效时间；到点后停止调用，不静默降级
  expiresAt      DateTime?
  /// 平台侧的额外信息（scope、tenant 等），仅存非敏感内容
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// 数据源注入状态（微信 / QQ / 飞书 / 钉钉 / 知乎 / SBTI）
model PersonaSource {
  id         String            @id @default(cuid())
  personaId  String
  type       PersonaSourceType
  status     String            @default("not_injected") // not_injected | injected | distilling
  meta       Json?
  importedAt DateTime?
  persona    Persona           @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, type])
}

// 人格结论证据（可解释性：为什么认为你是这样的人）
model PersonaEvidence {
  id        String  @id @default(cuid())
  personaId String
  source    String
  trait     String
  value     Float?
  note      String?
  url       String?
  /// 这条内容发生的时间。
  ///
  /// 为什么要存：可数行为变量（主动发起率 / 回应速度 / 活跃天占比 / 深夜活跃）
  /// 全靠时间戳，而原来的证据表只有文本 —— 时间在解析时被丢掉了。
  /// 老数据这一列是 null，那几项指标会如实留空，重新导入一次即可补上。
  occurredAt DateTime?
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)
}

// 结构化人格特征/向量分面
model PersonaFeature {
  id        String  @id @default(cuid())
  personaId String
  key       String
  value     Json
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, key])
}

model Match {
  id         String   @id @default(cuid())
  personaAId String
  personaBId String
  mode       String   @default("quick")
  status     String   @default("pending") // pending | agent_running | report_ready
  score      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  personaA Persona        @relation("PersonaAsA", fields: [personaAId], references: [id], onDelete: Cascade)
  personaB Persona        @relation("PersonaAsB", fields: [personaBId], references: [id], onDelete: Cascade)
  sessions AgentSession[]
  report   MatchReport?

  @@index([personaAId])
  @@index([personaBId])
}

model AgentSession {
  id              String             @id @default(cuid())
  matchId         String
  status          AgentSessionStatus @default(pending)
  currentRound    Int                @default(0)
  maxRounds       Int                @default(6)
  initiatorUserId String?
  meta            Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())

  match    Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages AgentMessage[]
}

model AgentMessage {
  id        String       @id @default(cuid())
  sessionId String
  role      String // system | agent_a | agent_b | judge
  content   String
  round     Int          @default(0)
  createdAt DateTime     @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, round])
}

model MatchReport {
  id           String   @id @default(cuid())
  matchId      String   @unique
  result       Json
  overallScore Float
  summary      String?
  createdAt    DateTime @default(now())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // agent_completed | report_received | ...
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

// 用户自备 LLM（BYOK）：预设或自定义；apiKey 加密存储
model LlmProviderConfig {
  id          String    @id @default(cuid())
  userId      String
  type        String // preset | custom
  providerKey String? // preset id，如 zhipu / deepseek
  displayName String
  baseUrl     String
  apiKeyEnc   String
  model       String // 请求的 model 参数（预设默认模型或自定义模型名）
  isDefault   Boolean   @default(false)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  latencyMs   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
